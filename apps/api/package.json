{
  "name": "@estate-crm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm --filter @estate-crm/database build && tsc -b tsconfig.build.json",
    "start": "node dist/server.js",
    "bootstrap-admin": "node dist/auth/bootstrap-admin.js",
    "typecheck": "tsc -b tsconfig.build.json --pretty false",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@estate-crm/contracts": "workspace:*",
    "@estate-crm/database": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "tsx": "^4.23.13",
    "typescript": "6.0.2"
  }
}
