generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  LEAD
  MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ContactSource {
  META
  WEBSITE
  MANUAL
}

enum DealOperation {
  PURCHASE
  RENT
  SALE
}

enum ActivityCategory {
  NOTE
  TASK
  CHANGE
  SOURCE
  OBJECT
}

model Organization {
  id          String       @id @default(uuid()) @db.Uuid
  name        String
  slug        String       @unique
  timezone    String       @default("Europe/Madrid")
  locale      String       @default("ru")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  memberships Membership[]
  contacts    Contact[]
  pipelines   Pipeline[]
  deals       Deal[]
  activities  ActivityEvent[]

  @@map("organizations")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  email        String       @unique
  name         String
  phone        String?
  passwordHash String?      @map("password_hash")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  memberships  Membership[]
  sessions     Session[]
  assignedContacts Contact[] @relation("ContactAssignee")
  assignedDeals Deal[] @relation("DealAssignee")
  authoredActivities ActivityEvent[] @relation("ActivityAuthor")

  @@map("users")
}

model Contact {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  name            String
  phone           String?
  normalizedPhone String?       @map("normalized_phone")
  email           String?
  telegram        String?
  source          ContactSource @default(MANUAL)
  assigneeId      String?       @map("assignee_id") @db.Uuid
  comment         String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee        User?         @relation("ContactAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deals           Deal[]
  relatedDeals    DealRelatedContact[]
  activities      ActivityEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, normalizedPhone])
  @@index([assigneeId])
  @@map("contacts")
}

model Pipeline {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages         PipelineStage[]
  deals          Deal[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id         String   @id @default(uuid()) @db.Uuid
  pipelineId String   @map("pipeline_id") @db.Uuid
  title      String
  color      String
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals      Deal[]

  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id             String         @id @default(uuid()) @db.Uuid
  number         Int            @default(autoincrement())
  organizationId String         @map("organization_id") @db.Uuid
  pipelineId     String         @map("pipeline_id") @db.Uuid
  stageId        String         @map("stage_id") @db.Uuid
  contactId      String         @map("contact_id") @db.Uuid
  assigneeId     String?        @map("assignee_id") @db.Uuid
  title          String
  request        String
  budget         String?
  comment        String?
  operation      DealOperation  @default(PURCHASE)
  propertyType   String?        @map("property_type")
  district       String?
  rooms          String?
  source         ContactSource  @default(MANUAL)
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline       Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          PipelineStage  @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact        Contact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignee       User?          @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities     ActivityEvent[]
  relatedContacts DealRelatedContact[]

  @@unique([organizationId, number])
  @@index([pipelineId, stageId, position])
  @@index([contactId])
  @@index([assigneeId])
  @@map("deals")
}

model DealRelatedContact {
  dealId    String   @map("deal_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("deal_related_contacts")
}

model ActivityEvent {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  contactId      String?          @map("contact_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  authorId       String?          @map("author_id") @db.Uuid
  category       ActivityCategory
  title          String
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  author         User?            @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@map("activity_events")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(MANAGER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}
