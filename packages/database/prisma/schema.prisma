generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  LEAD
  MANAGER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum ContactSource {
  META
  WEBSITE
  MANUAL
}

enum DealOperation {
  PURCHASE
  RENT
  SALE
}

enum DealStatus {
  ACTIVE
  WON
  LOST
  ARCHIVED
}

enum ActivityCategory {
  NOTE
  TASK
  CHANGE
  SOURCE
  OBJECT
}

enum TaskKind {
  CALL
  MEETING
  MESSAGE
  OTHER
}

enum TaskStatus {
  ACTIVE
  COMPLETED
}

enum PropertyCategory {
  APARTMENT
  HOUSE
  LAND
  COMMERCIAL
}

enum PropertyMarket {
  PRIMARY
  SECONDARY
}

enum PropertyOperation {
  SALE
  RENT
}

enum PropertyStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum Currency {
  USD
  EUR
}

enum IntegrationProvider {
  TEST
  META_LEAD_ADS
  INSTAGRAM_DIRECT
  TELEPHONY
  TELEGRAM
}

enum IntegrationConnectionStatus {
  READY
  CREDENTIALS_REQUIRED
  CONNECTED
  ERROR
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
  FAILED
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum TelegramRecipientScope {
  ORGANIZATION
  OWN
}

enum TelegramNotificationAudience {
  ALL
  OWN
  SELECTED
  NONE
}

enum NotificationDeliveryStatus {
  PENDING
  SENT
  FAILED
}

model Organization {
  id                     String                  @id @default(uuid()) @db.Uuid
  name                   String
  slug                   String                  @unique
  timezone               String                  @default("Europe/Madrid")
  locale                 String                  @default("ru")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  memberships            Membership[]
  contacts               Contact[]
  pipelines              Pipeline[]
  deals                  Deal[]
  activities             ActivityEvent[]
  contactRelations       ContactRelation[]
  tasks                  Task[]
  properties             Property[]
  integrationConnections IntegrationConnection[]
  integrationEvents      IntegrationEvent[]
  notificationOutbox     NotificationOutbox[]
  telegramRecipients     TelegramRecipient[]
  telegramConnectTokens  TelegramConnectToken[]
  teamInvitations        TeamInvitation[]

  @@map("organizations")
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  email                 String                 @unique
  name                  String
  phone                 String?
  passwordHash          String?                @map("password_hash")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  memberships           Membership[]
  sessions              Session[]
  assignedContacts      Contact[]              @relation("ContactAssignee")
  assignedDeals         Deal[]                 @relation("DealAssignee")
  authoredActivities    ActivityEvent[]        @relation("ActivityAuthor")
  assignedTasks         Task[]                 @relation("TaskAssignee")
  telegramRecipients    TelegramRecipient[]
  telegramConnectTokens TelegramConnectToken[]
  telegramSelections    TelegramRecipientSelection[] @relation("TelegramSelectedUser")
  receivedTeamInvitations TeamInvitation[]          @relation("TeamInvitationUser")
  sentTeamInvitations     TeamInvitation[]          @relation("TeamInvitationSender")

  @@map("users")
}

model Contact {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  name              String
  phone             String?
  normalizedPhone   String?              @map("normalized_phone")
  email             String?
  telegram          String?
  source            ContactSource        @default(MANUAL)
  assigneeId        String?              @map("assignee_id") @db.Uuid
  comment           String?
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee          User?                @relation("ContactAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  deals             Deal[]
  relatedDeals      DealRelatedContact[]
  relationsAsA      ContactRelation[]    @relation("ContactRelationA")
  relationsAsB      ContactRelation[]    @relation("ContactRelationB")
  activities        ActivityEvent[]
  tasks             Task[]
  integrationEvents IntegrationEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, normalizedPhone])
  @@index([assigneeId])
  @@map("contacts")
}

model ContactRelation {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  contactAId     String       @map("contact_a_id") @db.Uuid
  contactBId     String       @map("contact_b_id") @db.Uuid
  label          String?
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactA       Contact      @relation("ContactRelationA", fields: [contactAId], references: [id], onDelete: Cascade)
  contactB       Contact      @relation("ContactRelationB", fields: [contactBId], references: [id], onDelete: Cascade)

  @@unique([contactAId, contactBId])
  @@index([organizationId])
  @@index([contactBId])
  @@map("contact_relations")
}

model Pipeline {
  id                     String                  @id @default(uuid()) @db.Uuid
  organizationId         String                  @map("organization_id") @db.Uuid
  name                   String
  isDefault              Boolean                 @default(false) @map("is_default")
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stages                 PipelineStage[]
  deals                  Deal[]
  integrationConnections IntegrationConnection[]

  @@index([organizationId])
  @@map("pipelines")
}

model PipelineStage {
  id                     String                  @id @default(uuid()) @db.Uuid
  pipelineId             String                  @map("pipeline_id") @db.Uuid
  title                  String
  color                  String
  position               Int
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")
  pipeline               Pipeline                @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals                  Deal[]
  integrationConnections IntegrationConnection[]

  @@unique([pipelineId, position])
  @@index([pipelineId])
  @@map("pipeline_stages")
}

model Deal {
  id                String               @id @default(uuid()) @db.Uuid
  number            Int                  @default(autoincrement())
  organizationId    String               @map("organization_id") @db.Uuid
  pipelineId        String               @map("pipeline_id") @db.Uuid
  stageId           String               @map("stage_id") @db.Uuid
  contactId         String               @map("contact_id") @db.Uuid
  assigneeId        String?              @map("assignee_id") @db.Uuid
  title             String
  request           String
  budget            String?
  comment           String?
  operation         DealOperation        @default(PURCHASE)
  propertyType      String?              @map("property_type")
  district          String?
  rooms             String?
  source            ContactSource        @default(MANUAL)
  status            DealStatus           @default(ACTIVE)
  position          Int                  @default(0)
  closedAt          DateTime?            @map("closed_at")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline             @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage             PipelineStage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact           Contact              @relation(fields: [contactId], references: [id], onDelete: Restrict)
  assignee          User?                @relation("DealAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  activities        ActivityEvent[]
  relatedContacts   DealRelatedContact[]
  tasks             Task[]
  integrationEvents IntegrationEvent[]

  @@unique([organizationId, number])
  @@index([pipelineId, status, stageId, position])
  @@index([contactId])
  @@index([assigneeId])
  @@map("deals")
}

model DealRelatedContact {
  dealId    String   @map("deal_id") @db.Uuid
  contactId String   @map("contact_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([dealId, contactId])
  @@index([contactId])
  @@map("deal_related_contacts")
}

model ActivityEvent {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  contactId      String?          @map("contact_id") @db.Uuid
  dealId         String?          @map("deal_id") @db.Uuid
  authorId       String?          @map("author_id") @db.Uuid
  category       ActivityCategory
  title          String
  description    String?
  createdAt      DateTime         @default(now()) @map("created_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  author         User?            @relation("ActivityAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([contactId, createdAt])
  @@index([dealId, createdAt])
  @@map("activity_events")
}

model IntegrationConnection {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  provider          IntegrationProvider
  status            IntegrationConnectionStatus @default(CREDENTIALS_REQUIRED)
  enabled           Boolean                     @default(false)
  pipelineId        String?                     @map("pipeline_id") @db.Uuid
  stageId           String?                     @map("stage_id") @db.Uuid
  config            Json?
  webhookSecretHash String?                     @unique @map("webhook_secret_hash")
  lastEventAt       DateTime?                   @map("last_event_at")
  lastError         String?                     @map("last_error")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")
  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pipeline          Pipeline?                   @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  stage             PipelineStage?              @relation(fields: [stageId], references: [id], onDelete: SetNull)
  events            IntegrationEvent[]

  @@unique([organizationId, provider])
  @@index([organizationId, status])
  @@map("integration_connections")
}

model IntegrationEvent {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  connectionId   String?                @map("connection_id") @db.Uuid
  provider       IntegrationProvider
  externalId     String                 @map("external_id")
  eventType      String                 @map("event_type")
  payload        Json
  status         IntegrationEventStatus @default(RECEIVED)
  contactId      String?                @map("contact_id") @db.Uuid
  dealId         String?                @map("deal_id") @db.Uuid
  error          String?
  receivedAt     DateTime               @default(now()) @map("received_at")
  processedAt    DateTime?              @map("processed_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection     IntegrationConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  contact        Contact?               @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?                  @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, receivedAt])
  @@index([dealId, receivedAt])
  @@map("integration_events")
}

model NotificationOutbox {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  channel        IntegrationProvider      @default(TELEGRAM)
  eventType      String                   @map("event_type")
  title          String
  body           String
  actionUrl      String?                  @map("action_url")
  payload        Json?
  dedupeKey      String?                  @map("dedupe_key")
  status         NotificationOutboxStatus @default(PENDING)
  attempts       Int                      @default(0)
  nextAttemptAt  DateTime?                @map("next_attempt_at")
  lastError      String?                  @map("last_error")
  createdAt      DateTime                 @default(now()) @map("created_at")
  sentAt         DateTime?                @map("sent_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]

  @@index([organizationId, status, createdAt])
  @@unique([organizationId, channel, dedupeKey])
  @@map("notification_outbox")
}

model TelegramRecipient {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  chatId         String                 @map("chat_id")
  username       String?
  firstName      String?                @map("first_name")
  scope          TelegramRecipientScope
  audience       TelegramNotificationAudience @default(OWN)
  leadNotifications Boolean               @default(true) @map("lead_notifications")
  taskReminderNotifications Boolean       @default(true) @map("task_reminder_notifications")
  taskOverdueNotifications Boolean        @default(true) @map("task_overdue_notifications")
  active         Boolean                @default(true)
  connectedAt    DateTime               @default(now()) @map("connected_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries     NotificationDelivery[]
  selectedUsers  TelegramRecipientSelection[]

  @@unique([organizationId, userId])
  @@unique([organizationId, chatId])
  @@index([organizationId, active])
  @@map("telegram_recipients")
}

model TelegramRecipientSelection {
  id          String            @id @default(uuid()) @db.Uuid
  recipientId String            @map("recipient_id") @db.Uuid
  userId      String            @map("user_id") @db.Uuid
  recipient   TelegramRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  user        User              @relation("TelegramSelectedUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recipientId, userId])
  @@index([userId])
  @@map("telegram_recipient_selections")
}

model TelegramConnectToken {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  userId         String                 @map("user_id") @db.Uuid
  tokenHash      String                 @unique @map("token_hash")
  scope          TelegramRecipientScope
  expiresAt      DateTime               @map("expires_at")
  usedAt         DateTime?              @map("used_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt, usedAt])
  @@map("telegram_connect_tokens")
}

model NotificationDelivery {
  id             String                     @id @default(uuid()) @db.Uuid
  notificationId String                     @map("notification_id") @db.Uuid
  recipientId    String                     @map("recipient_id") @db.Uuid
  status         NotificationDeliveryStatus @default(PENDING)
  attempts       Int                        @default(0)
  nextAttemptAt  DateTime?                  @map("next_attempt_at")
  lastError      String?                    @map("last_error")
  sentAt         DateTime?                  @map("sent_at")
  createdAt      DateTime                   @default(now()) @map("created_at")
  notification   NotificationOutbox         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient      TelegramRecipient          @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([notificationId, recipientId])
  @@index([status, nextAttemptAt])
  @@map("notification_deliveries")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  title          String
  kind           TaskKind     @default(CALL)
  status         TaskStatus   @default(ACTIVE)
  dueDate        DateTime?    @map("due_date") @db.Date
  dueTime        String?      @map("due_time")
  result         String?
  completedAt    DateTime?    @map("completed_at")
  contactId      String?      @map("contact_id") @db.Uuid
  dealId         String?      @map("deal_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  deal           Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, dueDate])
  @@index([contactId])
  @@index([dealId])
  @@index([assigneeId])
  @@map("tasks")
}

model Property {
  id             String            @id @default(uuid()) @db.Uuid
  number         Int               @default(autoincrement())
  organizationId String            @map("organization_id") @db.Uuid
  title          String
  address        String?
  district       String?
  category       PropertyCategory
  market         PropertyMarket
  operation      PropertyOperation @default(SALE)
  status         PropertyStatus    @default(AVAILABLE)
  price          Float             @default(0)
  currency       Currency          @default(USD)
  rooms          String?
  area           Float             @default(0)
  floor          Int?
  totalFloors    Int?              @map("total_floors")
  landArea       Float?            @map("land_area")
  project        String?
  developer      String?
  description    String?
  imageUrl       String?           @map("image_url")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, number])
  @@index([organizationId, status, updatedAt])
  @@map("properties")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Membership {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  role           MembershipRole   @default(MANAGER)
  status         MembershipStatus @default(INVITED)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("memberships")
}

model TeamInvitation {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  invitedById    String    @map("invited_by_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  acceptedAt     DateTime? @map("accepted_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation("TeamInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("TeamInvitationSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([userId, expiresAt])
  @@map("team_invitations")
}
